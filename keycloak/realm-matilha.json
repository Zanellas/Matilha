{
  "realm": "matilha",
  "displayName": "Matilha",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      { "name": "customer", "description": "Cliente: vê e movimenta só as próprias contas" },
      { "name": "admin", "description": "Suporte: lista todas as contas, bloqueia e desbloqueia" }
    ]
  },
  "clients": [
    {
      "clientId": "matilha-web",
      "name": "Matilha (Postman e futuros front-ends)",
      "description": "Client público com Authorization Code e PKCE.",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["https://oauth.pstmn.io/v1/callback"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "audience-matilha-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "matilha-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "matilha-dev-cli",
      "name": "Matilha (scripts locais)",
      "description": "SÓ PARA DESENVOLVIMENTO. Aceita usuário e senha direto (password grant), para os scripts de k8s/provas e testes com curl. Não existiria em produção.",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocolMappers": [
        {
          "name": "audience-matilha-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "matilha-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "00000000-0000-0000-0003-000000000001",
      "username": "ana",
      "firstName": "Ana",
      "lastName": "Silva",
      "email": "ana.silva@example.com",
      "emailVerified": true,
      "enabled": true,
      "credentials": [{ "type": "password", "value": "ana123", "temporary": false }],
      "realmRoles": ["customer"]
    },
    {
      "id": "00000000-0000-0000-0003-000000000002",
      "username": "bruno",
      "firstName": "Bruno",
      "lastName": "Costa",
      "email": "bruno.costa@example.com",
      "emailVerified": true,
      "enabled": true,
      "credentials": [{ "type": "password", "value": "bruno123", "temporary": false }],
      "realmRoles": ["customer"]
    },
    {
      "id": "00000000-0000-0000-0003-000000000003",
      "username": "suporte",
      "firstName": "Suporte",
      "lastName": "Matilha",
      "email": "suporte@example.com",
      "emailVerified": true,
      "enabled": true,
      "credentials": [{ "type": "password", "value": "suporte123", "temporary": false }],
      "realmRoles": ["admin"]
    }
  ]
}
