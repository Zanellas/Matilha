          "name": "Consultar a transferência criada (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('é a transferência da pasta 2, COMPLETED', () => {",
                  "    pm.expect(body.id).to.eql(pm.collectionVariables.get('transferId'));",
