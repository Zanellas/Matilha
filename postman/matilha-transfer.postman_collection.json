{
  "info": {
    "name": "Matilha - Transfer",
    "description": "Roteiro de testes do matilha-transfer contra o matilha-account, os dois rodando localmente com o perfil dev.\n\nRode as pastas 1 a 5 em ordem com o Collection Runner. A pasta 6 é manual: pare o account antes de rodar.\n\nAs requisições usam as contas de exemplo do perfil dev (10001 a 10005).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "accountUrl", "value": "http://localhost:8081" },
    { "key": "transferUrl", "value": "http://localhost:8082" },
    { "key": "amount", "value": "100.00" },
    { "key": "successKey", "value": "" },
    { "key": "transferId", "value": "" },
    { "key": "sourceBalanceBefore", "value": "" },
    { "key": "targetBalanceBefore", "value": "" },
    { "key": "pendingTransferId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Preparação",
      "item": [
        {
          "name": "Health do transfer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('transfer está UP', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().status).to.eql('UP');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{transferUrl}}/actuator/health",
              "host": ["{{transferUrl}}"],
              "path": ["actuator", "health"]
            }
          }
        },
        {
          "name": "Saldo inicial da 10001 (origem)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('conta encontrada', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('sourceBalanceBefore', pm.response.json().balance);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{accountUrl}}/accounts/10001",
              "host": ["{{accountUrl}}"],
              "path": ["accounts", "10001"]
            }
          }
        },
        {
          "name": "Saldo inicial da 10002 (destino)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('conta encontrada', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('targetBalanceBefore', pm.response.json().balance);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{accountUrl}}/accounts/10002",
              "host": ["{{accountUrl}}"],
              "path": ["accounts", "10002"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Sucesso e idempotência",
      "item": [
        {
          "name": "Transferência com sucesso (201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// chave nova a cada execução; os próximos requests da pasta reutilizam a mesma",
                  "pm.collectionVariables.set('successKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('status 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('transferência COMPLETED', () => pm.expect(body.status).to.eql('COMPLETED'));",
                  "pm.test('Location aponta para a transferência', () => {",
                  "    pm.expect(pm.response.headers.get('Location')).to.eql('/transfers/' + body.id);",
                  "});",
                  "pm.collectionVariables.set('transferId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{successKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountNumber\": \"10001\",\n  \"targetAccountNumber\": \"10002\",\n  \"amount\": {{amount}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{transferUrl}}/transfers",
              "host": ["{{transferUrl}}"],
              "path": ["transfers"]
            }
          }
        },
        {
          "name": "Reenvio com a mesma chave (mesma resposta)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('mesmo status HTTP da primeira vez (201)', () => pm.response.to.have.status(201));",
                  "pm.test('devolve a MESMA transferência', () => {",
                  "    pm.expect(body.id).to.eql(pm.collectionVariables.get('transferId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{successKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountNumber\": \"10001\",\n  \"targetAccountNumber\": \"10002\",\n  \"amount\": {{amount}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{transferUrl}}/transfers",
              "host": ["{{transferUrl}}"],
              "path": ["transfers"]
            }
          }
        },
        {
          "name": "Reenvio com valor no outro formato (100.0)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('100.0 e 100.00 contam como o mesmo pedido', () => {",
                  "    pm.response.to.have.status(201);",
                  "    pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('transferId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{successKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountNumber\": \"10001\",\n  \"targetAccountNumber\": \"10002\",\n  \"amount\": 100.0\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{transferUrl}}/transfers",
              "host": ["{{transferUrl}}"],
              "path": ["transfers"]
            }
          }
        },
        {
          "name": "Mesma chave com valor diferente (422)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 422', () => pm.response.to.have.status(422));",
                  "pm.test('explica que a chave já foi usada', () => {",
                  "    pm.expect(pm.response.json().detail).to.eql('Idempotency key already used with different data');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{successKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountNumber\": \"10001\",\n  \"targetAccountNumber\": \"10002\",\n  \"amount\": 50.00\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{transferUrl}}/transfers",
              "host": ["{{transferUrl}}"],
              "path": ["transfers"]
            }
          }
        },
        {
          "name": "Saldo da 10001 caiu UMA vez só",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const cents = v => Math.round(Number(v) * 100);",
                  "const before = cents(pm.collectionVariables.get('sourceBalanceBefore'));",
                  "const amount = cents(pm.collectionVariables.get('amount'));",
                  "pm.test('saldo = inicial - valor (os reenvios não moveram dinheiro)', () => {",
                  "    pm.expect(cents(pm.response.json().balance)).to.eql(before - amount);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{accountUrl}}/accounts/10001",
              "host": ["{{accountUrl}}"],
              "path": ["accounts", "10001"]
            }
          }
        },
        {
          "name": "Saldo da 10002 subiu UMA vez só",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const cents = v => Math.round(Number(v) * 100);",
                  "const before = cents(pm.collectionVariables.get('targetBalanceBefore'));",
                  "const amount = cents(pm.collectionVariables.get('amount'));",
                  "pm.test('saldo = inicial + valor', () => {",
                  "    pm.expect(cents(pm.response.json().balance)).to.eql(before + amount);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{accountUrl}}/accounts/10002",
              "host": ["{{accountUrl}}"],
              "path": ["accounts", "10002"]
            }
          }
        }
      ]
    },
