    {
      "name": "7. MANUAL - Account fora do ar (202 PENDING)",
      "description": "1) PARE o matilha-account (docker compose stop account, ou Ctrl+C se roda na máquina) e rode a primeira requisição: 202 PENDING. Nenhum evento sai ainda: PENDING não gera evento.\n2) Suba o account de novo, espere ~1min30 e rode as outras duas: o reconciliador já terá marcado COMPLETED, o evento TransferCompleted aparece na Kafka UI e a 10001 recebe a notificação.\nNão rode esta pasta junto com as outras no Runner.",
      "item": [
        {
          "name": "Transferência com o account parado (202)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('status 202 Accepted', () => pm.response.to.have.status(202));",
                  "pm.test('transferência PENDING, sem código nem motivo de falha', () => {",
                  "    pm.expect(body.status).to.eql('PENDING');",
                  "    pm.expect(body.failureCode).to.be.null;",
                  "    pm.expect(body.failureReason).to.be.null;",
                  "});",
                  "pm.test('Location para consultar depois', () => {",
                  "    pm.expect(pm.response.headers.get('Location')).to.eql('/transfers/' + body.id);",
                  "});",
                  "pm.collectionVariables.set('pendingTransferId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountNumber\": \"10001\",\n  \"targetAccountNumber\": \"10002\",\n  \"amount\": 10.00\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{transferUrl}}/transfers",
              "host": ["{{transferUrl}}"],
              "path": ["transfers"]
            }
          }
        },
        {
          "name": "Consultar depois do reconciliador (COMPLETED)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Suba o account de novo e espere ~1min30 antes de rodar (min-age 30s + intervalo de 60s).",
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('o reconciliador resolveu a PENDING', () => {",
                  "    pm.expect(pm.response.json().status).to.eql('COMPLETED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{transferUrl}}/transfers/{{pendingTransferId}}",
              "host": ["{{transferUrl}}"],
              "path": ["transfers", "{{pendingTransferId}}"]
            }
          }
        },
        {
          "name": "Notificação da PENDING resolvida (10001)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Rode depois da anterior dar COMPLETED: só aí o evento existe.",
                  "const pendingId = pm.collectionVariables.get('pendingTransferId');",
                  "const mine = pm.response.json().content.filter(n => n.transferId === pendingId);",
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('a transferência que ficou PENDING gerou TRANSFER_SENT', () => {",
                  "    pm.expect(mine).to.have.lengthOf(1);",
                  "    pm.expect(mine[0].type).to.eql('TRANSFER_SENT');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{notificationUrl}}/notifications?accountNumber=10001&size=100",
              "host": ["{{notificationUrl}}"],
              "path": ["notifications"],
              "query": [
                { "key": "accountNumber", "value": "10001" },
                { "key": "size", "value": "100" }
              ]
            }
          }
        }
      ]
