    {
      "name": "6. MANUAL - Account fora do ar (202 PENDING)",
      "description": "1) PARE o matilha-account (Ctrl+C) e rode a primeira requisição: 202 PENDING.\n2) Suba o account de novo, espere ~1min30 e rode a segunda: o reconciliador já terá marcado COMPLETED.\nNão rode esta pasta junto com as outras no Runner.",
      "item": [
        {
          "name": "Transferência com o account parado (202)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('status 202 Accepted', () => pm.response.to.have.status(202));",
                  "pm.test('transferência PENDING, sem motivo de falha', () => {",
                  "    pm.expect(body.status).to.eql('PENDING');",
                  "    pm.expect(body.failureReason).to.be.null;",
                  "});",
                  "pm.test('Location para consultar depois', () => {",
                  "    pm.expect(pm.response.headers.get('Location')).to.eql('/transfers/' + body.id);",
                  "});",
                  "pm.collectionVariables.set('pendingTransferId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountNumber\": \"10001\",\n  \"targetAccountNumber\": \"10002\",\n  \"amount\": 10.00\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{transferUrl}}/transfers",
              "host": ["{{transferUrl}}"],
              "path": ["transfers"]
            }
          }
        },
        {
          "name": "Consultar depois do reconciliador (COMPLETED)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Suba o account de novo e espere ~1min30 antes de rodar (min-age 30s + intervalo de 60s).",
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('o reconciliador resolveu a PENDING', () => {",
                  "    pm.expect(pm.response.json().status).to.eql('COMPLETED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
