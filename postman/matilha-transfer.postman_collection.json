    {
      "name": "4. Consulta",
      "item": [
        {
          "name": "Consultar a transferência criada (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('é a transferência da pasta 2, COMPLETED', () => {",
                  "    pm.expect(body.id).to.eql(pm.collectionVariables.get('transferId'));",
                  "    pm.expect(body.status).to.eql('COMPLETED');",
                  "    pm.expect(body.failureCode).to.be.null;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{transferUrl}}/transfers/{{transferId}}",
              "host": ["{{transferUrl}}"],
              "path": ["transfers", "{{transferId}}"]
            }
          }
        },
        {
          "name": "Consultar a transferência recusada (failureCode)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
